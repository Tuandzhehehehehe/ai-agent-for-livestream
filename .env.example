# Local model confidence floor; lower values route more comments to retrieval.
LOCAL_INTENT_CONFIDENCE_THRESHOLD=0.10

CHAT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_SECONDS=10
CHAT_BLOCKED_TERMS=

# MongoDB configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=replace_with_mongo_password
MONGODB_PORT=27017
MONGODB_URI=mongodb://admin:replace_with_mongo_password@localhost:27017/?authSource=admin
MONGODB_DATABASE=livestream_sales
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis configuration
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_CONNECT_TIMEOUT_SECONDS=5.0
